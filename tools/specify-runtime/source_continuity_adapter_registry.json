{
  "schema": "spec-kit-source-continuity-adapter-registry-v1",
  "providers": [
    {
      "id": "structure-observer",
      "version": "1",
      "description": "Enumerates inspectable surfaces and captures typed structure evidence without claiming runtime behavior.",
      "detection_signals": ["source-resource-inspection", "dom-accessibility-inspection", "native-widget-tree", "cli-tui-structure"],
      "capabilities": ["surface-enumeration"],
      "actions": ["enumerate-surfaces", "capture-structure"],
      "evidence_kinds": ["structure_snapshot"],
      "allowed_execution_modes": ["runtime-managed", "agent-tool", "app-connector", "external-runner", "manual-attested"],
      "write_policy": "read-only",
      "network_policy": "denied"
    },
    {
      "id": "behavior-driver",
      "version": "1",
      "description": "Activates real user actions with isolated test data and observes runtime effects and final states.",
      "detection_signals": ["browser-automation", "desktop-automation", "app-connector", "cli-tui-runner"],
      "capabilities": ["action-execution", "side-effect-observation"],
      "actions": ["enumerate-actions", "activate-action", "observe-side-effects", "capture-runtime", "prepare-isolated-test-data"],
      "evidence_kinds": ["runtime_diagnostics"],
      "allowed_execution_modes": ["runtime-managed", "agent-tool", "app-connector", "external-runner", "manual-attested"],
      "write_policy": "isolated-test-data",
      "network_policy": "declared-read-only"
    },
    {
      "id": "visual-asset-observer",
      "version": "1",
      "description": "Inspects identity-bearing assets and captures visual evidence for source-target comparison.",
      "detection_signals": ["image-inspection", "screenshot-capture", "asset-resource-inspection"],
      "capabilities": ["asset-inspection", "visual-capture"],
      "actions": ["enumerate-assets", "capture-visual"],
      "evidence_kinds": ["visual_capture"],
      "allowed_execution_modes": ["runtime-managed", "agent-tool", "app-connector", "external-runner", "manual-attested"],
      "write_policy": "read-only",
      "network_policy": "denied"
    }
  ]
}
