{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kit-plus.local/schemas/test-design-handoff-schema.json",
  "title": "Spec Kit Plus Test Design Tasks Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_fingerprint",
    "state_revision",
    "claim_status",
    "artifact_refs",
    "artifact_digests",
    "test_case_refs",
    "test_data_refs",
    "gap_ref",
    "audit_result_ref",
    "next_command"
  ],
  "properties": {
    "schema_version": { "const": "spec-kit-test-design-handoff-v1" },
    "source_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "state_revision": { "type": "integer", "minimum": 1 },
    "claim_status": { "enum": ["complete_against_frozen_scope", "qualified_with_declared_gaps"] },
    "artifact_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "universe", "catalog", "data_manifest", "coverage_matrix"],
      "properties": {
        "state": { "type": "string", "minLength": 1 },
        "universe": { "type": "string", "minLength": 1 },
        "catalog": { "type": "string", "minLength": 1 },
        "data_manifest": { "type": "string", "minLength": 1 },
        "coverage_matrix": { "type": "string", "minLength": 1 }
      }
    },
    "artifact_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "universe", "catalog", "data_manifest", "coverage_matrix", "gaps", "audit_result"],
      "properties": {
        "state": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "universe": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "catalog": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "data_manifest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "coverage_matrix": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "gaps": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "audit_result": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "test_case_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "test_data_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "gap_ref": { "type": "string", "minLength": 1 },
    "audit_result_ref": { "type": "string", "minLength": 1 },
    "next_command": { "const": "/sp.tasks" }
  }
}
