{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kit-plus.local/schemas/test-data-manifest-schema.json",
  "title": "Spec Kit Plus Test Data Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "artifact",
    "datasets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "artifact": {
      "const": "test-data-manifest"
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataset"
      }
    }
  },
  "$defs": {
    "test_case_ref": {
      "type": "string",
      "pattern": "^TC-[0-9]{3,}$"
    },
    "scenario_ref": {
      "type": "string",
      "pattern": "^SCN-[0-9]{3,}$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_data_id",
        "name",
        "kind",
        "sensitivity",
        "contains_pii",
        "source",
        "applicable_test_case_ids",
        "applicable_scenario_ids",
        "hygiene"
      ],
      "properties": {
        "test_data_id": {
          "type": "string",
          "pattern": "^TD-[0-9]{3,}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "fixture",
            "seed",
            "synthetic",
            "golden",
            "replay",
            "reference"
          ]
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "sanitized",
            "restricted"
          ]
        },
        "contains_pii": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "generated",
            "curated",
            "captured",
            "imported",
            "reused",
            "human-provided"
          ]
        },
        "applicable_test_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/test_case_ref"
          }
        },
        "applicable_scenario_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scenario_ref"
          }
        },
        "hygiene": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification_reason",
            "sanitization_status",
            "retention_policy"
          ],
          "properties": {
            "classification_reason": {
              "type": "string",
              "minLength": 1
            },
            "sanitization_status": {
              "enum": [
                "not_required",
                "sanitized",
                "restricted-access",
                "pending",
                "blocked"
              ]
            },
            "retention_policy": {
              "enum": [
                "ephemeral",
                "release-bound",
                "long-lived",
                "manual-review"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "contains_pii": {
                "const": true
              }
            },
            "required": [
              "contains_pii"
            ]
          },
          "then": {
            "properties": {
              "sensitivity": {
                "enum": [
                  "restricted"
                ]
              },
              "hygiene": {
                "properties": {
                  "sanitization_status": {
                    "enum": [
                      "sanitized",
                      "restricted-access",
                      "pending",
                      "blocked"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
