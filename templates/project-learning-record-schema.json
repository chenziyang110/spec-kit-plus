{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kit-plus.local/schemas/project-learning-record-schema.json",
  "title": "Project Learning Agent Read Contract",
  "description": "Read-only progressive-disclosure contract: start/list return compact decision cards; show expands exactly one card.",
  "oneOf": [
    { "$ref": "#/$defs/startSummary" },
    { "$ref": "#/$defs/summaryList" },
    { "$ref": "#/$defs/detailRecord" }
  ],
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "redactionLabels": {
      "type": "array",
      "items": {
        "enum": [
          "credential",
          "email",
          "private_key",
          "machine_path",
          "personal_identifier",
          "business_identifier",
          "organization_sensitive"
        ]
      },
      "uniqueItems": true,
      "description": "Canonical labels for sanitized agent-facing replacements such as [REDACTED_SECRET], [REDACTED_EMAIL], [REDACTED_PRIVATE_KEY], <USER_HOME>/..., [REDACTED_PHONE], [REDACTED_BUSINESS_ID], or [REDACTED_ORG_TERM]."
    },
    "contentSafety": {
      "type": "object",
      "required": ["sensitivity"],
      "properties": {
        "sensitivity": {
          "enum": ["safe", "sanitized"],
          "description": "safe means no sensitive content is present; sanitized means sensitive source content was abstracted or replaced in the agent-facing projection."
        },
        "risk_tier": { "enum": ["none", "moderate", "high"] },
        "redaction_labels": { "$ref": "#/$defs/redactionLabels" }
      },
      "additionalProperties": false
    },
    "learningValue": {
      "type": "object",
      "required": ["tier", "reason_codes"],
      "properties": {
        "tier": { "enum": ["high", "medium", "low"] },
        "reason_codes": {
          "type": "array",
          "items": {
            "enum": [
              "explicit_capture",
              "workflow_gap",
              "user_correction",
              "reusable_constraint",
              "near_miss",
              "repeated_occurrence",
              "tooling_trap",
              "recovery_path",
              "high_signal",
              "routine_outcome"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Canonical, content-free reasons for the value tier."
        }
      },
      "additionalProperties": false
    },
    "assessmentContentSafety": {
      "type": "object",
      "required": ["sensitivity", "risk_tier", "redaction_labels"],
      "properties": {
        "sensitivity": { "enum": ["safe", "sanitized"] },
        "risk_tier": { "enum": ["none", "moderate", "high"] },
        "redaction_labels": { "$ref": "#/$defs/redactionLabels" }
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": [
        "learning_value",
        "content_safety",
        "decision",
        "decision_reason"
      ],
      "properties": {
        "learning_value": { "$ref": "#/$defs/learningValue" },
        "content_safety": { "$ref": "#/$defs/assessmentContentSafety" },
        "decision": {
          "enum": ["capture-safe", "capture-sanitized", "defer", "ignore"]
        },
        "decision_reason": {
          "enum": [
            "safe_content",
            "valuable_after_abstraction",
            "sensitive_without_reusable_abstraction",
            "routine_outcome"
          ],
          "description": "Canonical explanation of the decision; it must not contain raw evidence."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "decision": { "const": "capture-safe" } },
            "required": ["decision"]
          },
          "then": {
            "properties": {
              "content_safety": {
                "properties": {
                  "sensitivity": { "const": "safe" },
                  "risk_tier": { "const": "none" },
                  "redaction_labels": { "maxItems": 0 }
                },
                "required": ["sensitivity", "risk_tier", "redaction_labels"]
              },
              "decision_reason": { "const": "safe_content" }
            }
          }
        },
        {
          "if": {
            "properties": { "decision": { "const": "capture-sanitized" } },
            "required": ["decision"]
          },
          "then": {
            "properties": {
              "content_safety": {
                "properties": {
                  "sensitivity": { "const": "sanitized" },
                  "risk_tier": { "enum": ["moderate", "high"] },
                  "redaction_labels": { "minItems": 1 }
                },
                "required": ["sensitivity", "risk_tier", "redaction_labels"]
              },
              "decision_reason": { "const": "valuable_after_abstraction" }
            }
          }
        },
        {
          "if": {
            "properties": { "decision": { "const": "defer" } },
            "required": ["decision"]
          },
          "then": {
            "properties": {
              "content_safety": {
                "properties": {
                  "sensitivity": { "const": "sanitized" },
                  "risk_tier": { "enum": ["moderate", "high"] },
                  "redaction_labels": { "minItems": 1 }
                },
                "required": ["sensitivity", "risk_tier", "redaction_labels"]
              },
              "decision_reason": {
                "const": "sensitive_without_reusable_abstraction"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "decision": { "const": "ignore" } },
            "required": ["decision"]
          },
          "then": {
            "properties": {
              "learning_value": {
                "properties": { "tier": { "const": "low" } },
                "required": ["tier"]
              },
              "decision_reason": { "const": "routine_outcome" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "learning_value": {
                "properties": { "tier": { "const": "low" } },
                "required": ["tier"]
              }
            },
            "required": ["learning_value"]
          },
          "then": {
            "properties": { "decision": { "const": "ignore" } }
          }
        }
      ],
      "additionalProperties": false
    },
    "learningFacets": {
      "type": "object",
      "properties": {
        "components": { "$ref": "#/$defs/stringList" },
        "operation_owners": { "$ref": "#/$defs/stringList" },
        "consumer_owners": { "$ref": "#/$defs/stringList" },
        "outcomes": { "$ref": "#/$defs/stringList" },
        "states": { "$ref": "#/$defs/stringList" },
        "entrypoints": { "$ref": "#/$defs/stringList" },
        "validation_surfaces": { "$ref": "#/$defs/stringList" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "contextMatch": {
      "type": "object",
      "required": [
        "matched_facets",
        "matched_dimensions",
        "matched_values",
        "exact_operation_owner",
        "cross_command"
      ],
      "properties": {
        "matched_facets": { "$ref": "#/$defs/learningFacets" },
        "matched_dimensions": { "type": "integer", "minimum": 1 },
        "matched_values": { "type": "integer", "minimum": 1 },
        "exact_operation_owner": { "type": "boolean" },
        "cross_command": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "learningType": {
      "enum": [
        "pitfall",
        "recovery_path",
        "user_preference",
        "workflow_gap",
        "project_constraint",
        "routing_mistake",
        "verification_gap",
        "state_surface_gap",
        "map_coverage_gap",
        "tooling_trap",
        "false_lead_pattern",
        "near_miss",
        "decision_debt"
      ]
    },
    "learningStatus": {
      "enum": ["candidate", "confirmed", "promoted-rule", "indexed"]
    },
    "summaryCard": {
      "type": "object",
      "required": [
        "ref",
        "summary",
        "action",
        "type",
        "status",
        "signal",
        "occurrences",
        "applies_to",
        "trigger_signals",
        "source_layer",
        "show_argv"
      ],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1, "description": "One-line sanitized agent-facing identity; evidence, raw content, and rationale are intentionally omitted." },
        "action": { "type": "string", "minLength": 1, "description": "Imperative next action for a future Agent." },
        "type": { "$ref": "#/$defs/learningType" },
        "status": { "$ref": "#/$defs/learningStatus" },
        "signal": { "enum": ["low", "medium", "high"] },
        "occurrences": { "type": "integer", "minimum": 1 },
        "applies_to": { "$ref": "#/$defs/stringList" },
        "trigger_signals": { "$ref": "#/$defs/stringList", "description": "Canonical sanitized agent-facing trigger tags for new records; legacy records may contain older free-form tags for compatibility." },
        "source_layer": { "enum": ["candidate", "confirmed-learning", "project-rule", "index-only"] },
        "sensitivity": { "enum": ["safe", "sanitized"] },
        "redaction_labels": { "$ref": "#/$defs/redactionLabels" },
        "assessment": { "$ref": "#/$defs/assessment" },
        "show_argv": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 7,
          "description": "Ready-to-execute argv that expands only this record."
        },
        "why_relevant": { "type": "string", "minLength": 1 },
        "context_match": { "$ref": "#/$defs/contextMatch" }
      },
      "additionalProperties": false
    },
    "summaryList": {
      "type": "object",
      "required": [
        "schema_version",
        "record_schema",
        "command",
        "policy",
        "filters",
        "pagination",
        "items",
        "warnings"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "record_schema": { "const": ".specify/templates/project-learning-record-schema.json#/$defs/summaryList" },
        "command": { "type": ["string", "null"] },
        "policy": { "type": ["string", "null"] },
        "task_context": { "$ref": "#/$defs/learningFacets" },
        "filters": {
          "type": "object",
          "required": ["type", "status", "query"],
          "properties": {
            "type": { "type": ["string", "null"] },
            "status": { "type": ["string", "null"] },
            "query": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "pagination": {
          "type": "object",
          "required": ["cursor", "limit", "returned", "total", "next_cursor", "next_argv"],
          "properties": {
            "cursor": { "type": "integer", "minimum": 0 },
            "limit": { "type": ["integer", "null"], "minimum": 1 },
            "returned": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 },
            "next_cursor": { "type": ["integer", "null"], "minimum": 0 },
            "next_argv": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "minItems": 9
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/summaryCard" }
        },
        "warnings": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": false
    },
    "startSummary": {
      "type": "object",
      "required": [
        "schema_version",
        "record_schema",
        "command",
        "policy",
        "read_only",
        "items",
        "pagination",
        "promotion_ready",
        "needs_confirmation",
        "warnings"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "record_schema": { "const": ".specify/templates/project-learning-record-schema.json#/$defs/startSummary" },
        "command": { "type": "string", "minLength": 1 },
        "policy": { "enum": ["skip", "consume-only", "consume-capture"] },
        "read_only": { "const": true },
        "task_context": { "$ref": "#/$defs/learningFacets" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/summaryCard" }
        },
        "pagination": { "$ref": "#/$defs/pagination" },
        "promotion_ready": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "summary", "occurrences"],
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "occurrences": { "type": "integer", "minimum": 2 }
            },
            "additionalProperties": false
          }
        },
        "needs_confirmation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "summary", "signal"],
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "signal": { "enum": ["low", "medium", "high"] }
            },
            "additionalProperties": false
          }
        },
        "warnings": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": false
    },
    "pagination": {
      "type": "object",
      "required": ["cursor", "limit", "returned", "total", "next_cursor", "next_argv"],
      "properties": {
        "cursor": { "type": "integer", "minimum": 0 },
        "limit": { "type": ["integer", "null"], "minimum": 1 },
        "returned": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "next_cursor": { "type": ["integer", "null"], "minimum": 0 },
        "next_argv": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 9
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "detailRecord": {
      "type": "object",
      "required": [
        "schema_version",
        "record_schema",
        "ref",
        "id",
        "summary",
        "type",
        "status",
        "guidance",
        "applicability",
        "evidence",
        "provenance",
        "lifecycle",
        "detail_path",
        "warnings"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "record_schema": { "const": ".specify/templates/project-learning-record-schema.json#/$defs/detailRecord" },
        "ref": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/learningType" },
        "status": { "$ref": "#/$defs/learningStatus" },
        "guidance": {
          "type": "object",
          "required": ["problem", "action", "avoid", "success_criteria", "exceptions"],
          "properties": {
            "problem": { "type": "string", "minLength": 1 },
            "action": { "type": "string", "minLength": 1 },
            "avoid": { "$ref": "#/$defs/stringList" },
            "success_criteria": { "$ref": "#/$defs/stringList" },
            "exceptions": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        },
        "applicability": {
          "type": "object",
          "required": ["commands", "trigger_signals", "scope"],
          "properties": {
            "commands": { "$ref": "#/$defs/stringList" },
            "trigger_signals": { "$ref": "#/$defs/stringList", "description": "Canonical sanitized agent-facing trigger tags for new records; legacy records may contain older free-form tags for compatibility." },
            "scope": { "type": "string" },
            "facets": { "$ref": "#/$defs/learningFacets" }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "required": ["observation", "decisive_signal", "false_starts", "rejected_paths", "root_cause_family"],
          "properties": {
            "observation": { "type": "string", "minLength": 1, "description": "Sanitized agent-facing projection; raw sensitive values must remain outside Learning storage, registry, and read API payloads." },
            "decisive_signal": { "type": "string" },
            "false_starts": { "$ref": "#/$defs/stringList" },
            "rejected_paths": { "$ref": "#/$defs/stringList" },
            "root_cause_family": { "type": "string" }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": ["source_command", "first_seen", "last_seen", "occurrences", "source_layer"],
          "properties": {
            "source_command": { "type": "string", "minLength": 1 },
            "first_seen": { "type": "string" },
            "last_seen": { "type": "string" },
            "occurrences": { "type": "integer", "minimum": 1 },
            "source_layer": { "enum": ["candidate", "confirmed-learning", "project-rule", "index-only"] }
          },
          "additionalProperties": false
        },
        "lifecycle": {
          "type": "object",
          "required": ["signal", "pain_score", "injection_targets", "promotion_hint"],
          "properties": {
            "signal": { "enum": ["low", "medium", "high"] },
            "pain_score": { "type": "integer", "minimum": 0 },
            "injection_targets": { "$ref": "#/$defs/stringList" },
            "promotion_hint": { "type": "string" }
          },
          "additionalProperties": false
        },
        "content_safety": { "$ref": "#/$defs/contentSafety" },
        "assessment": { "$ref": "#/$defs/assessment" },
        "detail_path": { "type": ["string", "null"] },
        "warnings": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": false
    }
  }
}
