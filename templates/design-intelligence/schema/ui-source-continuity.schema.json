{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kit-plus.local/schemas/ui-source-continuity-v1.json",
  "title": "Spec Kit Plus UI Source Continuity v1",
  "description": "Binds a reconstructed or adapted UI to its governing visual, runtime, implementation, behavior, and asset sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "applicability",
    "mode",
    "reason",
    "coverage",
    "authority_refs",
    "surface_bindings",
    "action_bindings",
    "asset_bindings",
    "unresolved_gaps"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "spec-kit-ui-source-continuity-v1"
    },
    "applicability": {
      "type": "string",
      "enum": ["not-assessed", "not-applicable", "required"]
    },
    "mode": {
      "type": "string",
      "enum": [
        "none",
        "reference-grounded",
        "live-product",
        "implementation-backed",
        "mixed"
      ]
    },
    "reason": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "null" }
      ]
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "authority_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "surface_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/surfaceBinding" }
    },
    "action_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/actionBinding" }
    },
    "asset_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/assetBinding" }
    },
    "unresolved_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "migrationPartExpectation": {"type":"object","additionalProperties":false,"required":["part","expectation"],"properties":{"part":{"type":"string","minLength":1,"pattern":"\\S"},"expectation":{"type":"string","minLength":1,"pattern":"\\S"}}},
    "migrationStateExpectation": {"type":"object","additionalProperties":false,"required":["state","behavior","visuals"],"properties":{"state":{"type":"string","minLength":1,"pattern":"\\S"},"behavior":{"type":"string","minLength":1,"pattern":"\\S"},"visuals":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/migrationPartExpectation"}}}},
    "migrationComponentStates": {"type":"object","additionalProperties":false,"required":["component_id","parts","required_states","states"],"properties":{"component_id":{"type":"string","minLength":1,"pattern":"\\S"},"parts":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"\\S"}},"required_states":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"\\S"}},"states":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/migrationStateExpectation"}}}},
    "migrationSize": {"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":1,"maximum":2147483647}},
    "migrationAssetVariant": {"type":"object","additionalProperties":false,"required":["state","source_ref","target_ref","source_size","target_size"],"properties":{"state":{"type":"string","minLength":1,"pattern":"\\S"},"source_ref":{"type":"string","minLength":1,"pattern":"\\S"},"target_ref":{"type":"string","minLength":1,"pattern":"\\S"},"source_size":{"$ref":"#/$defs/migrationSize"},"target_size":{"$ref":"#/$defs/migrationSize"}}},
    "migrationStateVariants": {"type":"object","additionalProperties":false,"required":["required_states","variants"],"properties":{"required_states":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"\\S"}},"variants":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/migrationAssetVariant"}}}},
    "migrationNativeOperation": {"type":"object","additionalProperties":false,"required":["api_ref","permission_required","permission_refs","permission_reason","expected_effect","effect_requirement","effect_fields"],"properties":{"api_ref":{"type":"string","minLength":1,"pattern":"\\S"},"permission_required":{"type":"boolean"},"permission_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"\\S"}},"permission_reason":{"type":"string","minLength":1,"pattern":"\\S"},"expected_effect":{"type":"string","minLength":1,"pattern":"\\S"},"effect_requirement":{"enum":["state-change","observation"]},"effect_fields":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"\\S"}}}},
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_ids", "interaction_ids", "component_ids"],
      "properties": {
        "surface_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "interaction_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "component_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        }
      }
    },
    "surfaceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "surface_id",
        "source_refs",
        "discovery",
        "disposition",
        "rationale"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "surface_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" },
        "discovery": {
          "type": "string",
          "enum": ["measured", "inferred", "assumption"]
        },
        "disposition": {
          "type": "string",
          "enum": ["preserve", "adapt", "replace", "merge", "split", "retire"]
        },
        "use_intent": {
          "type": "string",
          "enum": ["exact", "preserve-structure", "inspiration", "extract-tokens", "do-not-copy"]
        },
        "fidelity": {
          "type": "string",
          "enum": ["exact", "high", "approximate", "inspiration"]
        },
        "rationale": { "$ref": "#/$defs/nonEmptyString" },
        "component_states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/migrationComponentStates" } }
      }
    },
    "actionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "interaction_id",
        "source_refs",
        "user_promise",
        "business_outcome",
        "side_effects",
        "final_state",
        "verification"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "interaction_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" },
        "user_promise": { "$ref": "#/$defs/nonEmptyString" },
        "business_outcome": { "$ref": "#/$defs/nonEmptyString" },
        "side_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "final_state": { "$ref": "#/$defs/nonEmptyString" },
        "verification": { "$ref": "#/$defs/nonEmptyString" },
        "native_operation": { "$ref": "#/$defs/migrationNativeOperation" }
      }
    },
    "assetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component_id",
        "semantic_role",
        "source_refs",
        "target_strategy",
        "target_ref",
        "provenance",
        "fallback",
        "placeholder_policy"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "component_id": { "$ref": "#/$defs/nonEmptyString" },
        "semantic_role": { "$ref": "#/$defs/nonEmptyString" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" },
        "target_strategy": {
          "type": "string",
          "enum": [
            "preserve",
            "map-library",
            "owned",
            "text-only",
            "approved-exception"
          ]
        },
        "target_ref": { "$ref": "#/$defs/nonEmptyString" },
        "provenance": { "$ref": "#/$defs/nonEmptyString" },
        "fallback": { "$ref": "#/$defs/nonEmptyString" },
        "state_variants": { "$ref": "#/$defs/migrationStateVariants" },
        "placeholder_policy": {
          "type": "string",
          "enum": [
            "forbid-character-substitution",
            "approved-text-symbol"
          ]
        }
      }
    }
  }
}
