{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kit-plus.local/schemas/ui-source-continuity-v1.json",
  "title": "Spec Kit Plus UI Source Continuity v1",
  "description": "Binds a reconstructed or adapted UI to its governing visual, runtime, implementation, behavior, and asset sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "applicability",
    "mode",
    "reason",
    "coverage",
    "authority_refs",
    "surface_bindings",
    "action_bindings",
    "asset_bindings",
    "unresolved_gaps"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "spec-kit-ui-source-continuity-v1"
    },
    "applicability": {
      "type": "string",
      "enum": ["not-assessed", "not-applicable", "required"]
    },
    "mode": {
      "type": "string",
      "enum": [
        "none",
        "reference-grounded",
        "live-product",
        "implementation-backed",
        "mixed"
      ]
    },
    "reason": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "null" }
      ]
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "authority_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "surface_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/surfaceBinding" }
    },
    "action_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/actionBinding" }
    },
    "asset_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/assetBinding" }
    },
    "unresolved_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_ids", "interaction_ids", "component_ids"],
      "properties": {
        "surface_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "interaction_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "component_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        }
      }
    },
    "surfaceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "surface_id",
        "source_refs",
        "discovery",
        "disposition",
        "rationale"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "surface_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" },
        "discovery": {
          "type": "string",
          "enum": ["measured", "inferred", "assumption"]
        },
        "disposition": {
          "type": "string",
          "enum": ["preserve", "adapt", "replace", "merge", "split", "retire"]
        },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "actionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "interaction_id",
        "source_refs",
        "user_promise",
        "business_outcome",
        "side_effects",
        "final_state",
        "verification"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "interaction_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" },
        "user_promise": { "$ref": "#/$defs/nonEmptyString" },
        "business_outcome": { "$ref": "#/$defs/nonEmptyString" },
        "side_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "final_state": { "$ref": "#/$defs/nonEmptyString" },
        "verification": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "assetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component_id",
        "semantic_role",
        "source_refs",
        "target_strategy",
        "target_ref",
        "provenance",
        "fallback",
        "placeholder_policy"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "component_id": { "$ref": "#/$defs/nonEmptyString" },
        "semantic_role": { "$ref": "#/$defs/nonEmptyString" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" },
        "target_strategy": {
          "type": "string",
          "enum": [
            "preserve",
            "map-library",
            "owned",
            "text-only",
            "approved-exception"
          ]
        },
        "target_ref": { "$ref": "#/$defs/nonEmptyString" },
        "provenance": { "$ref": "#/$defs/nonEmptyString" },
        "fallback": { "$ref": "#/$defs/nonEmptyString" },
        "placeholder_policy": {
          "type": "string",
          "enum": [
            "forbid-character-substitution",
            "approved-text-symbol"
          ]
        }
      }
    }
  }
}
