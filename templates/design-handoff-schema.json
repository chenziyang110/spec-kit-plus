{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kit-plus.dev/schemas/design-handoff-schema.json",
  "title": "Spec Kit Plus immutable design handoff",
  "$defs": {
    "migrationPartExpectation": {"type":"object","additionalProperties":false,"required":["part","expectation"],"properties":{"part":{"type":"string","minLength":1,"pattern":"\\S"},"expectation":{"type":"string","minLength":1,"pattern":"\\S"}}},
    "migrationStateExpectation": {"type":"object","additionalProperties":false,"required":["state","behavior","visuals"],"properties":{"state":{"type":"string","minLength":1,"pattern":"\\S"},"behavior":{"type":"string","minLength":1,"pattern":"\\S"},"visuals":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/migrationPartExpectation"}}}},
    "migrationComponentStates": {"type":"object","additionalProperties":false,"required":["component_id","parts","required_states","states"],"properties":{"component_id":{"type":"string","minLength":1,"pattern":"\\S"},"parts":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"\\S"}},"required_states":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"\\S"}},"states":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/migrationStateExpectation"}}}},
    "migrationSize": {"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":1,"maximum":2147483647}},
    "migrationAssetVariant": {"type":"object","additionalProperties":false,"required":["state","source_ref","target_ref","source_size","target_size"],"properties":{"state":{"type":"string","minLength":1,"pattern":"\\S"},"source_ref":{"type":"string","minLength":1,"pattern":"\\S"},"target_ref":{"type":"string","minLength":1,"pattern":"\\S"},"source_size":{"$ref":"#/$defs/migrationSize"},"target_size":{"$ref":"#/$defs/migrationSize"}}},
    "migrationStateVariants": {"type":"object","additionalProperties":false,"required":["required_states","variants"],"properties":{"required_states":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"\\S"}},"variants":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/migrationAssetVariant"}}}},
    "migrationNativeOperation": {"type":"object","additionalProperties":false,"required":["api_ref","permission_required","permission_refs","permission_reason","expected_effect","effect_requirement","effect_fields"],"properties":{"api_ref":{"type":"string","minLength":1,"pattern":"\\S"},"permission_required":{"type":"boolean"},"permission_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"\\S"}},"permission_reason":{"type":"string","minLength":1,"pattern":"\\S"},"expected_effect":{"type":"string","minLength":1,"pattern":"\\S"},"effect_requirement":{"enum":["state-change","observation"]},"effect_fields":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"\\S"}}}},
    "handoffId": {
      "type": "string",
      "pattern": "^DH-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "handoffIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/handoffId"}
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "interactionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "action", "expected_feedback"],
      "properties": {
        "input": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "expected_feedback": {"type": "string", "minLength": 1}
      }
    },
    "interactionBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions", "setup", "expected_state_id", "expected_feedback", "focus_behavior", "announcement", "continuation"],
      "properties": {
        "conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["success", "failure", "timeout", "cancel", "retry", "duplicate", "out_of_order"]}
        },
        "setup": {"type": "string", "minLength": 1},
        "expected_state_id": {"$ref": "#/$defs/handoffId"},
        "expected_feedback": {"type": "string", "minLength": 1},
        "focus_behavior": {"type": "string", "minLength": 1},
        "announcement": {"type": "string", "minLength": 1},
        "continuation": {"type": "string", "minLength": 1}
      }
    },
    "interactionScript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preconditions", "start_state_id", "steps", "branches", "focus_checkpoint", "announcement_checkpoint", "completion_checkpoint", "recovery_checkpoint"],
      "properties": {
        "preconditions": {"$ref": "#/$defs/nonEmptyStrings"},
        "start_state_id": {"$ref": "#/$defs/handoffId"},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interactionStep"}},
        "branches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interactionBranch"}},
        "focus_checkpoint": {"type": "string", "minLength": 1},
        "announcement_checkpoint": {"type": "string", "minLength": 1},
        "completion_checkpoint": {"type": "string", "minLength": 1},
        "recovery_checkpoint": {"type": "string", "minLength": 1}
      }
    },
    "decisionIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^DS-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
      }
    },
    "specimenId": {
      "type": "string",
      "pattern": "^SP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "capabilityIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"}
    },
    "specimenIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/specimenId"}
    },
    "specimen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile_id", "kind", "title", "purpose", "capability_ids", "required_states", "content_keys"],
      "properties": {
        "id": {"$ref": "#/$defs/specimenId"},
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "capability_ids": {"$ref": "#/$defs/capabilityIds"},
        "required_states": {"$ref": "#/$defs/nonEmptyStrings"},
        "content_keys": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "profileContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "summary", "input_modes", "measurement_units"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "input_modes": {"$ref": "#/$defs/nonEmptyStrings"},
        "measurement_units": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "capabilityModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "profile_ids", "profiles", "capability_ids", "input_modes", "measurement_units", "specimens"],
      "properties": {
        "schema": {"const": "spec-kit-design-capability-model-v1"},
        "profile_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
        "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profileContract"}},
        "capability_ids": {"$ref": "#/$defs/capabilityIds"},
        "input_modes": {"$ref": "#/$defs/nonEmptyStrings"},
        "measurement_units": {"$ref": "#/$defs/nonEmptyStrings"},
        "specimens": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/specimen"}}
      }
    },
    "dataScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "data_condition", "expectation"],
      "properties": {
        "state": {"type": "string", "minLength": 1},
        "data_condition": {"type": "string", "minLength": 1},
        "expectation": {"type": "string", "minLength": 1}
      }
    },
    "interactionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "input", "trigger", "event_sequence", "immediate_feedback", "focus_behavior", "repeat_behavior", "cancellation_behavior", "pending_behavior", "decision_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/handoffId"},
        "surface": {"type": "string", "minLength": 1},
        "input": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "event_sequence": {"type": "string", "minLength": 1},
        "immediate_feedback": {"type": "string", "minLength": 1},
        "focus_behavior": {"type": "string", "minLength": 1},
        "repeat_behavior": {"type": "string", "minLength": 1},
        "cancellation_behavior": {"type": "string", "minLength": 1},
        "pending_behavior": {"type": "string", "minLength": 1},
        "decision_ids": {"$ref": "#/$defs/decisionIds"}
      }
    },
    "editingContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "input_methods", "composition_behavior", "paste_autofill_behavior", "selection_caret_behavior", "formatting_behavior", "validation_timing", "validation_feedback", "dirty_state_behavior", "persistence_behavior", "undo_redo_behavior", "conflict_behavior", "read_only_disabled_behavior", "submission_behavior", "decision_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/handoffId"},
        "surface": {"type": "string", "minLength": 1},
        "input_methods": {"$ref": "#/$defs/nonEmptyStrings"},
        "composition_behavior": {"type": "string", "minLength": 1},
        "paste_autofill_behavior": {"type": "string", "minLength": 1},
        "selection_caret_behavior": {"type": "string", "minLength": 1},
        "formatting_behavior": {"type": "string", "minLength": 1},
        "validation_timing": {"type": "string", "minLength": 1},
        "validation_feedback": {"type": "string", "minLength": 1},
        "dirty_state_behavior": {"type": "string", "minLength": 1},
        "persistence_behavior": {"type": "string", "minLength": 1},
        "undo_redo_behavior": {"type": "string", "minLength": 1},
        "conflict_behavior": {"type": "string", "minLength": 1},
        "read_only_disabled_behavior": {"type": "string", "minLength": 1},
        "submission_behavior": {"type": "string", "minLength": 1},
        "decision_ids": {"$ref": "#/$defs/decisionIds"}
      }
    },
    "dataStateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "state", "data_condition", "expectation", "decision_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/handoffId"},
        "surface": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1},
        "data_condition": {"type": "string", "minLength": 1},
        "expectation": {"type": "string", "minLength": 1},
        "decision_ids": {"$ref": "#/$defs/decisionIds"}
      }
    },
    "accessibilityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "semantics", "reading_order", "focus_order", "keyboard", "announcements", "target_size", "contrast", "zoom_reflow", "alternatives", "decision_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/handoffId"},
        "surface": {"type": "string", "minLength": 1},
        "semantics": {"$ref": "#/$defs/nonEmptyStrings"},
        "reading_order": {"type": "string", "minLength": 1},
        "focus_order": {"type": "string", "minLength": 1},
        "keyboard": {"$ref": "#/$defs/nonEmptyStrings"},
        "announcements": {"$ref": "#/$defs/nonEmptyStrings"},
        "target_size": {"type": "string", "minLength": 1},
        "contrast": {"type": "string", "minLength": 1},
        "zoom_reflow": {"type": "string", "minLength": 1},
        "alternatives": {"$ref": "#/$defs/nonEmptyStrings"},
        "decision_ids": {"$ref": "#/$defs/decisionIds"}
      }
    },
    "navigationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "entry", "destination", "trigger", "back_behavior", "deep_link_behavior", "interruption_recovery", "decision_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/handoffId"},
        "surface": {"type": "string", "minLength": 1},
        "entry": {"type": "string", "minLength": 1},
        "destination": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "back_behavior": {"type": "string", "minLength": 1},
        "deep_link_behavior": {"type": "string", "minLength": 1},
        "interruption_recovery": {"type": "string", "minLength": 1},
        "decision_ids": {"$ref": "#/$defs/decisionIds"}
      }
    },
    "contentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "state", "purpose", "copy", "primary_action", "trust_requirement", "localization", "content_limits", "decision_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/handoffId"},
        "surface": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "copy": {"type": "string", "minLength": 1},
        "primary_action": {"type": "string", "minLength": 1},
        "trust_requirement": {"type": "string", "minLength": 1},
        "localization": {"type": "string", "minLength": 1},
        "content_limits": {"$ref": "#/$defs/nonEmptyStrings"},
        "decision_ids": {"$ref": "#/$defs/decisionIds"}
      }
    },
    "motionTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "trigger", "response", "duration_ms", "easing", "interrupt_behavior", "decision_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/handoffId"},
        "surface": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "response": {"type": "string", "minLength": 1},
        "duration_ms": {"type": "integer", "minimum": 0},
        "easing": {"type": "string", "minLength": 1},
        "interrupt_behavior": {"type": "string", "minLength": 1},
        "decision_ids": {"$ref": "#/$defs/decisionIds"}
      }
    },
    "motionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "transitions", "reduced_motion", "feedback_timing"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "transitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/motionTransition"}},
        "reduced_motion": {"type": "string", "minLength": 1},
        "feedback_timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["immediate_ms", "progress_ms", "timeout_ms"],
          "properties": {
            "immediate_ms": {"type": "integer", "minimum": 0},
            "progress_ms": {"type": "integer", "minimum": 1},
            "timeout_ms": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "usabilityValidation": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"risk_level": {"const": "high"}}, "required": ["risk_level"]},
          "then": {"properties": {"human_review_required": {"const": true}}}
        }
      ],
      "required": ["risk_level", "methods", "critical_tasks", "success_criteria", "human_review_required"],
      "properties": {
        "risk_level": {"enum": ["low", "medium", "high"]},
        "methods": {"$ref": "#/$defs/nonEmptyStrings"},
        "critical_tasks": {"$ref": "#/$defs/nonEmptyStrings"},
        "success_criteria": {"$ref": "#/$defs/nonEmptyStrings"},
        "human_review_required": {"type": "boolean"},
        "smoothness_acceptance_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "performance_budgets": {"$ref": "#/$defs/smoothnessPerformanceBudgets"}
      }
    },
    "smoothnessPerformanceBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inp_ms", "long_task_ms", "cls", "animation_dropped_frame_pct", "bundle_delta_kb"],
      "properties": {
        "inp_ms": {"type": "number", "minimum": 0},
        "long_task_ms": {"type": "number", "minimum": 0},
        "cls": {"type": "number", "minimum": 0},
        "animation_dropped_frame_pct": {"type": "number", "minimum": 0},
        "bundle_delta_kb": {"type": "number", "minimum": 0}
      }
    },
    "componentAdoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "action", "package", "version", "license", "source_ref", "component_refs", "reason_codes", "selection_basis_refs", "permission_gate", "permission_status"],
      "properties": {
        "resource_id": {"type": "string", "minLength": 1},
        "action": {"enum": ["reuse", "extend", "add", "custom"]},
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "component_refs": {"$ref": "#/$defs/nonEmptyStrings"},
        "reason_codes": {"$ref": "#/$defs/nonEmptyStrings"},
        "selection_basis_refs": {"$ref": "#/$defs/nonEmptyStrings"},
        "permission_gate": {"enum": ["required", "not-required"]},
        "permission_status": {"enum": ["authorized", "not-authorized"]}
      }
    },
    "componentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component", "anatomy", "required_states", "interaction_modes", "data_scenarios", "variants", "content_constraints", "semantic_token_refs", "governance", "iconography", "decision_ids", "must_match"],
      "properties": {
        "id": {"$ref": "#/$defs/handoffId"},
        "component": {"type": "string", "minLength": 1},
        "anatomy": {"$ref": "#/$defs/nonEmptyStrings"},
        "required_states": {"$ref": "#/$defs/nonEmptyStrings"},
        "interaction_modes": {"$ref": "#/$defs/nonEmptyStrings"},
        "data_scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dataScenario"}},
        "variants": {"$ref": "#/$defs/nonEmptyStrings"},
        "content_constraints": {"$ref": "#/$defs/nonEmptyStrings"},
        "semantic_token_refs": {"$ref": "#/$defs/nonEmptyStrings"},
        "governance": {"enum": ["reuse", "extend", "new"]},
        "iconography": {"type": "string", "minLength": 1},
        "decision_ids": {"$ref": "#/$defs/decisionIds"},
        "must_match": {"$ref": "#/$defs/nonEmptyStrings"},
        "adoption": {"$ref": "#/$defs/componentAdoption"}
      }
    },
    "sourceContinuitySurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface_id", "source_refs", "discovery", "disposition", "rationale"],
      "properties": {
        "id": {"type": "string", "pattern": "^SC-SURFACE-[0-9]{3,}$"},
        "surface_id": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/nonEmptyStrings"},
        "discovery": {"enum": ["measured", "inferred", "assumption"]},
        "disposition": {"enum": ["preserve", "adapt", "replace", "merge", "split", "retire"]},
        "rationale": {"type": "string", "minLength": 1},
        "component_states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/migrationComponentStates"}}
      }
    },
    "sourceContinuityAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "interaction_id", "source_refs", "user_promise", "business_outcome", "side_effects", "final_state", "verification"],
      "properties": {
        "id": {"type": "string", "pattern": "^SC-ACTION-[0-9]{3,}$"},
        "interaction_id": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/nonEmptyStrings"},
        "user_promise": {"type": "string", "minLength": 1},
        "business_outcome": {"type": "string", "minLength": 1},
        "side_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "final_state": {"type": "string", "minLength": 1},
        "verification": {"type": "string", "minLength": 1},
        "native_operation": {"$ref": "#/$defs/migrationNativeOperation"}
      }
    },
    "sourceContinuityAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component_id", "semantic_role", "source_refs", "target_strategy", "target_ref", "provenance", "fallback", "placeholder_policy"],
      "properties": {
        "id": {"type": "string", "pattern": "^SC-ASSET-[0-9]{3,}$"},
        "component_id": {"type": "string", "minLength": 1},
        "semantic_role": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/nonEmptyStrings"},
        "target_strategy": {"enum": ["preserve", "map-library", "owned", "text-only", "approved-exception"]},
        "target_ref": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "fallback": {"type": "string", "minLength": 1},
        "placeholder_policy": {"enum": ["forbid-character-substitution", "approved-text-symbol"]},
        "state_variants": {"$ref": "#/$defs/migrationStateVariants"}
      }
    },
    "sourceContinuityCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_ids", "interaction_ids", "component_ids"],
      "properties": {
        "surface_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "interaction_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "component_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "sourceContinuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "applicability", "mode", "reason", "coverage", "authority_refs", "surface_bindings", "action_bindings", "asset_bindings", "unresolved_gaps"],
      "properties": {
        "schema": {"const": "spec-kit-ui-source-continuity-v1"},
        "applicability": {"enum": ["required", "not-applicable"]},
        "mode": {"enum": ["none", "reference-grounded", "live-product", "implementation-backed", "mixed"]},
        "reason": {"type": "string", "minLength": 1},
        "coverage": {"$ref": "#/$defs/sourceContinuityCoverage"},
        "authority_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "surface_bindings": {"type": "array", "items": {"$ref": "#/$defs/sourceContinuitySurface"}},
        "action_bindings": {"type": "array", "items": {"$ref": "#/$defs/sourceContinuityAction"}},
        "asset_bindings": {"type": "array", "items": {"$ref": "#/$defs/sourceContinuityAsset"}},
        "unresolved_gaps": {"type": "array", "maxItems": 0, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"applicability": {"const": "required"}}, "required": ["applicability"]},
          "then": {"properties": {
            "mode": {"not": {"const": "none"}},
              "authority_refs": {"minItems": 1},
              "coverage": {"properties": {"surface_ids": {"minItems": 1}, "interaction_ids": {"minItems": 1}, "component_ids": {"minItems": 1}}},
            "surface_bindings": {"minItems": 1},
            "action_bindings": {"minItems": 1},
            "asset_bindings": {"minItems": 1}
          }}
        },
        {
          "if": {"properties": {"applicability": {"const": "not-applicable"}}, "required": ["applicability"]},
          "then": {"properties": {
            "mode": {"const": "none"},
            "authority_refs": {"maxItems": 0},
            "coverage": {"properties": {"surface_ids": {"maxItems": 0}, "interaction_ids": {"maxItems": 0}, "component_ids": {"maxItems": 0}}},
            "surface_bindings": {"maxItems": 0},
            "action_bindings": {"maxItems": 0},
            "asset_bindings": {"maxItems": 0}
          }}
        }
      ]
    },
    "surfaceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile_id", "name", "kind", "entrypoint_id", "source_refs", "specimen_ids", "component_ids", "decision_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/handoffId"},
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "entrypoint_id": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/nonEmptyStrings"},
        "specimen_ids": {"$ref": "#/$defs/specimenIds"},
        "component_ids": {"$ref": "#/$defs/handoffIds"},
        "decision_ids": {"$ref": "#/$defs/decisionIds"}
      }
    },
    "scenarioContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface_id", "name", "risk", "required", "interaction_script", "interaction_ids", "editing_ids", "data_state_ids", "accessibility_ids", "navigation_ids", "content_ids", "responsive_ids", "motion_transition_ids", "decision_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/handoffId"},
        "surface_id": {"$ref": "#/$defs/handoffId"},
        "name": {"type": "string", "minLength": 1},
        "risk": {"enum": ["low", "medium", "high"]},
        "required": {"const": true},
        "interaction_script": {"$ref": "#/$defs/interactionScript"},
        "interaction_ids": {"$ref": "#/$defs/handoffIds"},
        "editing_ids": {"$ref": "#/$defs/handoffIds"},
        "data_state_ids": {"$ref": "#/$defs/handoffIds"},
        "accessibility_ids": {"$ref": "#/$defs/handoffIds"},
        "navigation_ids": {"$ref": "#/$defs/handoffIds"},
        "content_ids": {"$ref": "#/$defs/handoffIds"},
        "responsive_ids": {"$ref": "#/$defs/handoffIds"},
        "motion_transition_ids": {"$ref": "#/$defs/handoffIds"},
        "decision_ids": {"$ref": "#/$defs/decisionIds"}
      }
    },
    "renderTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "unit"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "unit": {"enum": ["px", "cell", "point"]}
      }
    },
    "responsiveContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile_id", "label", "target", "review_width_px", "state", "adaptation", "stretch_behavior", "overflow_behavior", "decision_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/handoffId"},
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "label": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/renderTarget"},
        "review_width_px": {"type": "integer", "minimum": 240, "maximum": 2400},
        "state": {"type": "string", "minLength": 1},
        "adaptation": {"type": "string", "minLength": 1},
        "stretch_behavior": {"type": "string", "minLength": 1},
        "overflow_behavior": {"type": "string", "minLength": 1},
        "decision_ids": {"$ref": "#/$defs/decisionIds"}
      }
    },
    "approvedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "color_mode", "motion_mode"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "color_mode": {"type": "string", "minLength": 1},
        "motion_mode": {"type": "string", "minLength": 1}
      }
    },
    "acceptanceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_id", "specimen_ids", "approved_targets", "states", "color_modes", "motion_modes", "decision_ids", "must_match", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/handoffId"},
        "target_id": {"$ref": "#/$defs/handoffId"},
        "specimen_ids": {"$ref": "#/$defs/specimenIds"},
        "approved_targets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/approvedTarget"}
        },
        "states": {"$ref": "#/$defs/nonEmptyStrings"},
        "color_modes": {"$ref": "#/$defs/nonEmptyStrings"},
        "motion_modes": {"$ref": "#/$defs/nonEmptyStrings"},
        "decision_ids": {"$ref": "#/$defs/decisionIds"},
        "must_match": {"$ref": "#/$defs/nonEmptyStrings"},
        "evidence": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "content", "tokens", "geometry", "color", "text_wrap", "motion", "platform_variance"],
      "properties": {
        "structure": {"const": "exact"},
        "content": {"const": "exact"},
        "tokens": {"const": "exact"},
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "max_delta"],
          "properties": {
            "unit": {"enum": ["px", "cell", "point"]},
            "max_delta": {"type": "number", "minimum": 0}
          }
        },
        "color": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "max_delta"],
          "properties": {
            "method": {"const": "delta-e-2000"},
            "max_delta": {"type": "number", "minimum": 0}
          }
        },
        "text_wrap": {"const": "exact"},
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "max_delta"],
          "properties": {
            "unit": {"const": "ms"},
            "max_delta": {"type": "number", "minimum": 0}
          }
        },
        "platform_variance": {"const": "approved-deviation-only"}
      }
    },
    "acceptedDeviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision_id", "reason", "approval_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/handoffId"},
        "decision_id": {
          "type": "string",
          "pattern": "^DS-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
        },
        "reason": {"type": "string", "minLength": 1},
        "approval_ref": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "approval", "project", "direction", "content", "boundaries", "decisions", "implementation_bindings", "reproduction"],
  "properties": {
    "schema": {"const": "spec-kit-design-handoff-v1"},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview_file", "preview_ref", "direction_id", "review_round", "preview_sha256", "manifest_sha256", "decision_ids", "visual_medium", "image_generation", "image_inspection", "image_editing", "inspection_owner", "prompt_strategy"],
      "properties": {
        "preview_file": {"type": "string", "minLength": 1},
        "preview_ref": {"type": "string", "minLength": 1},
        "visual_medium": {"enum": ["html", "image"]},
        "direction_id": {
          "type": "string",
          "pattern": "^direction-[a-z0-9][a-z0-9-]*$"
        },
        "review_round": {"type": "string", "minLength": 1},
        "preview_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prompt_ref": {"type": "string", "minLength": 1},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "image_generation": {"enum": ["available", "unavailable"]},
        "image_inspection": {"enum": ["available", "unavailable"]},
        "image_editing": {"enum": ["available", "unavailable"]},
        "inspection_owner": {"enum": ["agent-and-user", "user"]},
        "prompt_strategy": {"enum": ["image-generation", "html-authoring"]},
        "decision_ids": {"$ref": "#/$defs/decisionIds"}
      }
    },
    "project": {"type": "object", "minProperties": 1},
    "direction": {"type": "object", "minProperties": 1},
    "content": {"type": "object", "minProperties": 1},
    "boundaries": {"type": "object", "minProperties": 1},
    "decisions": {"type": "array", "minItems": 1},
    "implementation_bindings": {"type": "array", "minItems": 1},
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reproduction_mode", "source_continuity", "capability_model", "surface_catalog", "scenario_matrix", "component_contracts", "interaction_matrix", "editing_matrix", "data_state_matrix", "accessibility_matrix", "navigation_matrix", "content_matrix", "responsive_matrix", "motion_contract", "usability_validation", "visual_acceptance_matrix", "comparison_tolerance", "accepted_deviations", "contract_ids"],
      "properties": {
        "reproduction_mode": {"enum": ["exact", "platform-adapted"]},
        "source_continuity": {"$ref": "#/$defs/sourceContinuity"},
        "capability_model": {"$ref": "#/$defs/capabilityModel"},
        "surface_catalog": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surfaceContract"}},
        "scenario_matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenarioContract"}},
        "component_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/componentContract"}
        },
        "interaction_matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interactionContract"}},
        "editing_matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/editingContract"}},
        "data_state_matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dataStateContract"}},
        "accessibility_matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/accessibilityContract"}},
        "navigation_matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/navigationContract"}},
        "content_matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contentContract"}},
        "responsive_matrix": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/responsiveContract"}
        },
        "motion_contract": {"$ref": "#/$defs/motionContract"},
        "usability_validation": {"$ref": "#/$defs/usabilityValidation"},
        "visual_acceptance_matrix": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/acceptanceContract"}
        },
        "comparison_tolerance": {"$ref": "#/$defs/tolerance"},
        "accepted_deviations": {
          "type": "array",
          "items": {"$ref": "#/$defs/acceptedDeviation"}
        },
        "contract_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/handoffId"}
        }
      }
    }
  }
}
