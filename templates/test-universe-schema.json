{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kit-plus.local/schemas/test-universe-schema.json",
  "title": "Spec Kit Plus Test Universe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "artifact",
    "feature_ref",
    "capabilities",
    "scenarios",
    "test_cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "artifact": {
      "const": "test-universe"
    },
    "feature_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "test_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test_case"
      }
    }
  },
  "$defs": {
    "capability_id": {
      "type": "string",
      "pattern": "^CAP-[0-9]{3,}$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^SCN-[0-9]{3,}$"
    },
    "test_case_id": {
      "type": "string",
      "pattern": "^TC-[0-9]{3,}$"
    },
    "coverage_id": {
      "type": "string",
      "pattern": "^COV-[0-9]{3,}$"
    },
    "requirement_ref": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "title",
        "requirement_refs",
        "test_case_ids",
        "scenario_ids"
      ],
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/capability_id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "requirement_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirement_ref"
          }
        },
        "test_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/test_case_id"
          }
        },
        "scenario_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scenario_id"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "title",
        "capability_refs",
        "test_case_ids"
      ],
      "properties": {
        "scenario_id": {
          "$ref": "#/$defs/scenario_id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "capability_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability_id"
          }
        },
        "test_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/test_case_id"
          }
        },
        "coverage_ref": {
          "$ref": "#/$defs/coverage_id"
        },
        "coverage_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/coverage_id"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "coverage_ref"
          ]
        },
        {
          "required": [
            "coverage_refs"
          ]
        }
      ]
    },
    "test_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_case_id",
        "title",
        "kind",
        "capability_refs",
        "scenario_refs",
        "data_refs",
        "coverage_refs"
      ],
      "properties": {
        "test_case_id": {
          "$ref": "#/$defs/test_case_id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "unit",
            "integration",
            "workflow",
            "review",
            "acceptance",
            "research-proof"
          ]
        },
        "capability_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability_id"
          }
        },
        "scenario_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scenario_id"
          }
        },
        "data_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^TD-[0-9]{3,}$"
          }
        },
        "coverage_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/coverage_id"
          }
        }
      }
    }
  }
}
