{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/github/spec-kit-plus/templates/quick-confirmation-schema.json",
  "title": "quick-confirmation-v1",
  "type": "object",
  "required": ["schema", "confirmation_mode", "confirmation_state", "confirmation_digest", "source", "decision", "delivery"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "quick-confirmation-v1" },
    "workspace": { "type": "string" },
    "confirmation_mode": {
      "type": "string",
      "enum": ["full", "inherited", "delta"]
    },
    "confirmation_state": {
      "type": "string",
      "enum": ["staged", "confirmed", "inherited"]
    },
    "confirmation_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "description": "SHA-256 over decision fields only. Delivery and execution never enter the digest."
    },
    "source": {
      "type": "object",
      "required": ["kind", "semantic_delta"],
      "properties": {
        "kind": { "type": "string", "enum": ["prompt", "discussion", "delta"] },
        "discussion_slug": { "type": "string" },
        "review_digest": { "type": "string" },
        "semantic_delta": { "type": "boolean" },
        "delta_summary": { "type": "string" },
        "changed_decision_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Exact decision paths used to render a delta-only human view. Display metadata; excluded from confirmation_digest."
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "goal",
        "user_visible_result",
        "scope",
        "items",
        "reconfirmation_trigger"
      ],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "user_visible_result": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "object",
          "required": ["include", "exclude"],
          "properties": {
            "include": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "exclude": { "type": "array", "items": { "type": "string" } },
            "defer": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "deliverable", "depends_on", "acceptance"],
            "properties": {
              "id": { "type": "string", "pattern": "^Q[1-9][0-9]*$" },
              "deliverable": { "type": "string", "minLength": 1 },
              "depends_on": {
                "type": "array",
                "items": { "type": "string", "pattern": "^Q[1-9][0-9]*$" }
              },
              "acceptance": { "type": "string", "minLength": 1 },
              "write_scope": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Execution-facing write paths. Excluded from confirmation_digest."
              }
            },
            "additionalProperties": false
          }
        },
        "recommended_approach": { "type": "string" },
        "assumptions_and_risks": { "type": "array", "items": { "type": "string" } },
        "completion_evidence": { "type": "array", "items": { "type": "string" } },
        "reconfirmation_trigger": { "type": "string", "minLength": 1 },
        "ui_confirmation": {
          "type": ["object", "null"],
          "required": ["applicable"],
          "properties": {
            "applicable": { "type": "boolean" },
            "design_binding": {
              "type": ["object", "null"],
              "required": [
                "scope",
                "design_change_id",
                "design_change_ref",
                "design_change_sha256",
                "design_contract_ref"
              ],
              "properties": {
                "scope": { "type": "string", "minLength": 1 },
                "design_change_id": { "type": "string", "pattern": "^UD-[0-9]{4,}$" },
                "design_change_ref": { "type": "string", "minLength": 1 },
                "design_change_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "design_contract_ref": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "source_continuity": {
              "type": "object",
              "required": [
                "schema",
                "applicability",
                "mode",
                "reason",
                "coverage",
                "authority_refs",
                "surface_bindings",
                "action_bindings",
                "asset_bindings",
                "unresolved_gaps"
              ],
              "properties": {
                "schema": { "const": "spec-kit-ui-source-continuity-v1" },
                "applicability": {
                  "type": "string",
                  "enum": ["not-assessed", "not-applicable", "required"]
                },
                "mode": {
                  "type": "string",
                  "enum": ["none", "reference-grounded", "live-product", "implementation-backed", "mixed"]
                },
                "reason": {
                  "oneOf": [
                    { "type": "string", "minLength": 1, "pattern": "\\S" },
                    { "type": "null" }
                  ]
                },
                "coverage": {
                  "type": "object",
                  "required": ["surface_ids", "interaction_ids", "component_ids"],
                  "properties": {
                    "surface_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                    "interaction_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                    "component_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
                  },
                  "additionalProperties": false
                },
                "authority_refs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "surface_bindings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "surface_id", "source_refs", "discovery", "disposition", "rationale"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "surface_id": { "type": "string", "minLength": 1 },
                      "source_refs": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "type": "string", "minLength": 1 }
                      },
                      "discovery": { "type": "string", "enum": ["measured", "inferred", "assumption"] },
                      "disposition": { "type": "string", "enum": ["preserve", "adapt", "replace", "merge", "split", "retire"] },
                      "rationale": { "type": "string", "minLength": 1 }
                    },
                    "additionalProperties": false
                  }
                },
                "action_bindings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "interaction_id", "source_refs", "user_promise", "business_outcome", "side_effects", "final_state", "verification"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "interaction_id": { "type": "string", "minLength": 1 },
                      "source_refs": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "type": "string", "minLength": 1 }
                      },
                      "user_promise": { "type": "string", "minLength": 1 },
                      "business_outcome": { "type": "string", "minLength": 1 },
                      "side_effects": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": { "type": "string", "minLength": 1 }
                      },
                      "final_state": { "type": "string", "minLength": 1 },
                      "verification": { "type": "string", "minLength": 1 }
                    },
                    "additionalProperties": false
                  }
                },
                "asset_bindings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "component_id", "semantic_role", "source_refs", "target_strategy", "target_ref", "provenance", "fallback", "placeholder_policy"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "component_id": { "type": "string", "minLength": 1 },
                      "semantic_role": { "type": "string", "minLength": 1 },
                      "source_refs": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "type": "string", "minLength": 1 }
                      },
                      "target_strategy": {
                        "type": "string",
                        "enum": ["preserve", "map-library", "owned", "text-only", "approved-exception"]
                      },
                      "target_ref": { "type": "string", "minLength": 1 },
                      "provenance": { "type": "string", "minLength": 1 },
                      "fallback": { "type": "string", "minLength": 1 },
                      "placeholder_policy": {
                        "type": "string",
                        "enum": ["forbid-character-substitution", "approved-text-symbol"]
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": { "placeholder_policy": { "const": "approved-text-symbol" } },
                          "required": ["placeholder_policy"]
                        },
                        "then": {
                          "properties": {
                            "target_strategy": { "const": "approved-exception" },
                            "target_ref": {
                              "anyOf": [
                                { "pattern": "^(?:[Cc][Hh][Aa][Rr](?:[Aa][Cc][Tt][Ee][Rr])?|[Ee][Mm][Oo][Jj][Ii]|[Gg][Ll][Yy][Pp][Hh]|[Ss][Yy][Mm][Bb][Oo][Ll]|[Tt][Ee][Xx][Tt]|[Uu][Nn][Ii][Cc][Oo][Dd][Ee])\\s*:\\s*\\S" },
                                { "pattern": "^&#(?:[Xx][0-9A-Fa-f]+|[0-9]+);?$" },
                                { "pattern": "^(?:[Uu]\\+|\\\\[Uu])[0-9A-Fa-f]{4,8}$" },
                                { "maxLength": 4, "pattern": "[^A-Za-z0-9\\s]" }
                              ]
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": { "target_strategy": { "const": "approved-exception" } },
                          "required": ["target_strategy"]
                        },
                        "then": {
                          "properties": {
                            "placeholder_policy": { "const": "approved-text-symbol" }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": { "placeholder_policy": { "const": "forbid-character-substitution" } },
                          "required": ["placeholder_policy"]
                        },
                        "then": {
                          "properties": {
                            "target_ref": {
                              "allOf": [
                                { "not": { "pattern": "^[Tt][Ee][Xx][Tt]:" } },
                                { "not": { "pattern": "^\\s*.\\s*$" } }
                              ]
                            }
                          }
                        }
                      }
                    ],
                    "additionalProperties": false
                  }
                },
                "unresolved_gaps": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "applicability": { "const": "required" } },
                    "required": ["applicability"]
                  },
                  "then": {
                    "properties": {
                      "mode": { "not": { "const": "none" } },
                      "reason": { "type": "string", "minLength": 1, "pattern": "\\S" },
                      "coverage": { "properties": { "surface_ids": { "minItems": 1 }, "interaction_ids": { "minItems": 1 }, "component_ids": { "minItems": 1 } } },
                      "authority_refs": { "minItems": 1 },
                      "surface_bindings": { "minItems": 1 },
                      "action_bindings": { "minItems": 1 },
                      "asset_bindings": { "minItems": 1 },
                      "unresolved_gaps": { "maxItems": 0 }
                    }
                  }
                },
                {
                  "if": {
                    "properties": { "applicability": { "const": "not-applicable" } },
                    "required": ["applicability"]
                  },
                  "then": {
                    "properties": {
                      "mode": { "const": "none" },
                      "reason": { "type": "string", "minLength": 1, "pattern": "\\S" },
                      "coverage": { "properties": { "surface_ids": { "maxItems": 0 }, "interaction_ids": { "maxItems": 0 }, "component_ids": { "maxItems": 0 } } },
                      "authority_refs": { "maxItems": 0 },
                      "surface_bindings": { "maxItems": 0 },
                      "action_bindings": { "maxItems": 0 },
                      "asset_bindings": { "maxItems": 0 },
                      "unresolved_gaps": { "maxItems": 0 }
                    }
                  }
                },
                {
                  "if": {
                    "properties": { "applicability": { "const": "not-assessed" } },
                    "required": ["applicability"]
                  },
                  "then": {
                    "properties": {
                      "mode": { "const": "none" },
                      "coverage": { "properties": { "surface_ids": { "maxItems": 0 }, "interaction_ids": { "maxItems": 0 }, "component_ids": { "maxItems": 0 } } },
                      "authority_refs": { "maxItems": 0 },
                      "surface_bindings": { "maxItems": 0 },
                      "action_bindings": { "maxItems": 0 },
                      "asset_bindings": { "maxItems": 0 },
                      "unresolved_gaps": { "maxItems": 0 }
                    }
                  }
                }
              ],
              "additionalProperties": false
            },
            "confirmation_purpose": { "type": "string" },
            "user_and_primary_job": { "type": "string" },
            "design_basis_and_source_material": {
              "type": "array",
              "items": { "type": "string" }
            },
            "target_experience": { "type": "string" },
            "structure_and_visible_change": { "type": "string" },
            "interaction_states_and_adaptation": {
              "type": "array",
              "items": { "type": "string" }
            },
            "design_boundaries": {
              "type": "object",
              "properties": {
                "must_preserve": { "type": "array", "items": { "type": "string" } },
                "may_adapt": { "type": "array", "items": { "type": "string" } },
                "must_not": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            },
            "acceptance_evidence": {
              "type": "array",
              "items": { "type": "string" }
            },
            "confirmation_digest": { "type": "string" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "applicable": { "const": true } },
                "required": ["applicable"]
              },
              "then": { "required": ["source_continuity"] }
            }
          ],
          "additionalProperties": false
        },
        "user_corrections": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "required": ["waves"],
      "description": "Agent-owned execution projection. Never part of confirmation_digest.",
      "properties": {
        "waves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "item_ids"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "item_ids": {
                "type": "array",
                "items": { "type": "string", "pattern": "^Q[1-9][0-9]*$" },
                "minItems": 1
              },
              "parallel": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "join_points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["after", "starts"],
            "properties": {
              "after": { "type": "array", "items": { "type": "string" } },
              "starts": { "type": "string" },
              "gate": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "integration_gate": { "type": "string" }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "description": "Live pulse state. Never part of confirmation_digest.",
      "properties": {
        "work_item_status": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["work_item_id", "status"],
            "properties": {
              "work_item_id": { "type": "string", "pattern": "^Q[1-9][0-9]*$" },
              "status": {
                "type": "string",
                "enum": ["pending", "ready", "in_progress", "blocked", "accepted"]
              },
              "acceptance_evidence": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "active_item_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^Q[1-9][0-9]*$" }
        },
        "join_point": { "type": "string" },
        "blockers": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "staged_at": { "type": "string" },
    "confirmed_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
