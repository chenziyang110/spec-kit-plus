{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-kit-plus.dev/schemas/design-concept-lint-receipt.schema.json",
  "title": "Spec Kit Plus concept lint receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "status",
    "authority",
    "consumer_eligible",
    "lint_level",
    "design_change_id",
    "design_change_ref",
    "design_change_sha256",
    "scope",
    "capability_profile_ids",
    "visual_medium",
    "preview_file",
    "preview_ref",
    "preview_sha256",
    "review_round",
    "manifest_ref",
    "manifest_sha256",
    "visual_review"
  ],
  "properties": {
    "schema": {"const": "spec-kit-design-concept-lint-receipt-v1"},
    "status": {"const": "passed"},
    "authority": {"const": "non-consumable"},
    "consumer_eligible": {"const": false},
    "lint_level": {"const": "concept"},
    "design_change_id": {"type": "string", "pattern": "^UD-[0-9]{4,}$"},
    "design_change_ref": {"type": "string", "minLength": 1},
    "design_change_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capability_profile_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "visual_medium": {"enum": ["html", "image"]},
    "preview_file": {"type": "string", "minLength": 1},
    "preview_ref": {"type": "string", "minLength": 1},
    "preview_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "review_round": {"type": "string", "pattern": "^[1-9][0-9]{0,3}$"},
    "manifest_ref": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prompt_ref": {"type": "string", "minLength": 1},
    "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generation_ref": {"type": "string", "minLength": 1},
    "generation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "visual_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reviewer", "protected_surfaces", "observed_differences"],
      "properties": {
        "verdict": {"enum": ["pass", "pending-user", "not-required"]},
        "reviewer": {"enum": ["agent", "agent-and-user", "user", "runtime"]},
        "protected_surfaces": {"type": "array"},
        "observed_differences": {"type": "array"}
      }
    }
  }
}
