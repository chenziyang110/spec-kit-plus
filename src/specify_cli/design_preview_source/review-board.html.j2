<body
  data-design-preview-schema="spec-kit-design-preview-v1"
  data-preview-status="scaffold"
  data-review-round="01"
  data-approved-direction=""
  data-active-direction="direction-a"
>
  <header class="board-chrome" data-preview-section="board-chrome">
    <div>
      <h1>Freeform design review board</h1>
      <p>
        Chrome only. Each direction canvas is unconstrained so the agent can author
        taste-skill-style layouts, composition, type, and motion. Do not treat this
        shell as product UI. Replace freeform seed content with project-specific
        direction specimens before ready lint.
      </p>
    </div>
    <nav class="direction-tabs" aria-label="Design directions">
      <a href="#direction-a" id="tab-direction-a" data-direction-target="direction-a" role="tab" aria-selected="true">Direction A</a>
      <a href="#direction-b" id="tab-direction-b" data-direction-target="direction-b" role="tab" aria-selected="false">Direction B</a>
      <a href="#direction-c" id="tab-direction-c" data-direction-target="direction-c" role="tab" aria-selected="false">Direction C</a>
    </nav>
  </header>

  <main class="direction-stage">
    <section class="direction-canvas" id="direction-a" data-direction-id="direction-a" data-preview-section="direction" aria-labelledby="tab-direction-a">
      <div class="freeform-seed">
        <h2>Direction A freeform canvas</h2>
        <p>Replace this seed with a complete project-specific visual direction.</p>
        <p class="seed-note">
          Freeform canvas A. Author a complete self-contained visual direction here
          (hero, workspace, marketing, TUI, etc.). Keep comparison content constant
          across directions; change design language freely.
        </p>
      </div>
    </section>

    <section class="direction-canvas" id="direction-b" data-direction-id="direction-b" data-preview-section="direction" aria-labelledby="tab-direction-b">
      <div class="freeform-seed">
        <h2>Direction B freeform canvas</h2>
        <p>Replace this seed with a second differentiated visual system.</p>
        <p class="seed-note">
          Freeform canvas B. A second differentiated visual system for the same job,
          audience, and content baseline.
        </p>
      </div>
    </section>

    <section class="direction-canvas" id="direction-c" data-direction-id="direction-c" data-preview-section="direction" aria-labelledby="tab-direction-c">
      <div class="freeform-seed">
        <h2>Direction C freeform canvas</h2>
        <p>Replace this seed with a third differentiated visual system.</p>
        <p class="seed-note">
          Freeform canvas C. A third differentiated visual system. Avoid metadata-only
          differences; change real composition, type, density, motion, and palette.
        </p>
      </div>
    </section>
  </main>

  <script type="application/json" id="design-preview-manifest">
{% include "manifest.json" %}
  </script>

  <script>
{% include "runtime.js" %}
  </script>
</body>
</html>
