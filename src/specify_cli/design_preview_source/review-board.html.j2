<body
  data-design-preview-schema="spec-kit-design-preview-v1"
  data-preview-status="scaffold"
  data-prototype-status="seed"
  data-review-round="01"
  data-approved-direction=""
  data-active-direction="direction-main"
>
  <header class="board-chrome" data-preview-section="board-chrome">
    <div>
      <h1>Iterative design studio</h1>
      <p>
        One current concept per immutable round. Replace the seed with a complete,
        project-specific surface, inspect it at the target sizes, and revise the same
        direction in a new round until the user explicitly approves it.
      </p>
    </div>
    <a class="concept-link" href="#direction-main">Current concept</a>
  </header>

  <main class="direction-stage">
    <section class="direction-canvas" id="direction-main" data-direction-id="direction-main" data-preview-section="direction" aria-labelledby="concept-title">
      <div class="freeform-seed">
        <h2 id="concept-title">Unfinished prototype seed</h2>
        <p>Replace this seed with the complete project-specific concept before review.</p>
        <p class="seed-note">
          Use the selected platform guidance, real content, representative states,
          responsive/adaptive targets, and one memorable signature element. Set
          <code>data-prototype-status="authored"</code> only after browser inspection.
        </p>
      </div>
    </section>
  </main>

  <script type="application/json" id="design-preview-manifest">
{% include "manifest.json" %}
  </script>

  <script>
{% include "runtime.js" %}
  </script>
</body>
</html>
